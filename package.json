{
  "name": "rockspec",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "rockspec": "./packages/ledger/dist/bin.js"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "rockspec": "node packages/ledger/dist/bin.js",
    "validate:skills": "node scripts/validate-authoring.mjs skills"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
