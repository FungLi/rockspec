{
  "name": "rockspec",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "rockspec": "./packages/cli/dist/bin.js"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build && pnpm build:runtime",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:release": "pnpm build && node scripts/build-cli-release.mjs",
    "pack:cli": "pnpm build:release && npm pack ./packages/cli/release",
    "typecheck": "pnpm build && pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "rockspec": "node packages/cli/dist/bin.js",
    "check:skills": "vitest run tests/host-assets.test.ts",
    "validate:skills": "node scripts/validate-authoring.mjs skills",
    "validate:plugin": "node scripts/validate-authoring.mjs plugin"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
